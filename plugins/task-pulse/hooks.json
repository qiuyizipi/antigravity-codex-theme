{
  "task-pulse-tracker": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node scripts/hook.mjs SessionStart",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node scripts/hook.mjs PreInvocation",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node scripts/hook.mjs PostInvocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/hook.mjs Stop",
        "timeout": 5
      }
    ]
  }
}
